// Template for <repo-root>/.claude/settings.json
//
// THIS FILE IS COMMITTED. Everything in it must work on any machine and any OS.
//   - Relative paths only. No drive letters. No absolute paths of any kind.
//   - No secrets, tokens, or API keys.
//   - Nothing that is true only of your checkout.
// Anything machine-specific goes in .claude/settings.local.json instead
// (see settings.local.template.json).
//
// Reminder: this file loads ONLY from the directory you start Claude in. It is
// NOT inherited from parent directories the way CLAUDE.md files are. If you
// launch from a subdirectory too, that subdirectory needs its own copy.
//
// Keep the allow list consistent with the "Test framework:" line declared in
// AGENTS.md - both runners are allowed below because `python -m pytest` also
// runs a unittest suite, but the commands AGENTS.md documents should name the
// declared one.
//
// Strip these comments before saving - settings.json must be valid JSON.
{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "permissions": {
    // Every rule here is a Bash-tool rule. A Bash(...) rule does not govern
    // Claude Code's PowerShell tool, which has its own PowerShell(...) rules,
    // so a Windows machine with Git Bash turns that tool off
    // (CLAUDE_CODE_USE_POWERSHELL_TOOL=0 in the user environment) rather than
    // keeping two copies of every list.
    //
    // A rule without "*" matches one exact command: "Bash(npm test)" does not
    // match "npm test -- --watch". A trailing " *" also matches the bare
    // command, so "Bash(git log *)" covers "git log" too. Give a wildcard only
    // to commands that are read-only whatever their arguments: "git branch *"
    // would also approve "git branch -D", so git branch gets exact forms.
    //
    // The repo's own test, lint, and format commands. Read-only shell commands
    // (cat, head, tail, grep, find, wc, read-only git) need no rule: Claude Code
    // runs its built-in read-only set without a prompt in every mode.
    "allow": [
      "Bash(python -m pytest *)",
      "Bash(python -m unittest *)",
      "Bash(python -m ruff *)",
      "Bash(python -m mdformat *)",
      "Bash(python -c *)",
      "Bash(python --version)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git branch -a)",
      "Bash(git branch -r)",
      "Bash(git branch -vv)",
      "Bash(git ls-files *)"
    ],

    // Things that change history or the index: fine, but only on request.
    "ask": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(git stash *)"
    ],

    // Secrets, bulk history, deletion, publishing, and the network.
    // .gitignore'd paths are already excluded from searches automatically;
    // deny rules are for things that exist but must not be touched. A deny
    // cannot be approved at prompt time, so nothing goes here that AGENTS.md
    // allows on request - the "do not read .status/archive/ unless named"
    // guard is an instruction, not a deny.
    "deny": [
      "Read(.env)",
      "Read(.envrc)",
      "Bash(rm -rf *)",
      "Bash(rm -r *)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(pip install *)",
      "Bash(python -m pip install *)",
      "Bash(curl *)",
      "Bash(wget *)"
    ]

    // NOT HERE: "additionalDirectories". Sibling-repo paths are machine-specific.
    // Put them in .claude/settings.local.json.
  }
}

// ---------------------------------------------------------------------------
// Which file gets what
//
//   .claude/settings.json          COMMITTED   relative allow/ask/deny rules,
//                                              hooks that call repo-relative
//                                              scripts, worktree.sparsePaths
//   .claude/settings.local.json    GITIGNORED  additionalDirectories,
//                                              claudeMdExcludes, personal
//                                              permissions, absolute paths
//   ~/.claude/settings.json        LOCAL       your defaults for every project
//                                              (CLAUDE_CODE_GIT_BASH_PATH,
//                                              autoUpdatesChannel, model, ...)
//
// Precedence, highest first: managed policy -> CLI flags -> local -> project ->
// user. Permission rules MERGE across scopes rather than overriding.
// ---------------------------------------------------------------------------
